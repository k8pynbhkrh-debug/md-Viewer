<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App-Extensions im Mac App Store müssen sandboxed sein. Die Extension
	     bekommt den Lesezugriff auf die geteilte Datei über NSItemProvider /
	     LaunchServices, braucht daher keine weiteren Datei-Entitlements. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
