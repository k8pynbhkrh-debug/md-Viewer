    "Set md Viewer as the default for .md" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "md Viewer als Standard für .md festlegen"
          }
        }
      }
    },
    "Switches to a plain-text view where a passage can be selected and copied" : {
      "comment" : "Accessibility hint for the \"Select Text\" toolbar button.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechselt zu einer Nur-Text-Ansicht, in der sich ein Textabschnitt auswählen und kopieren lässt"
          }
        }
      }
    },
    "The app identifier could not be determined." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App-Kennung konnte nicht ermittelt werden."
          }
        }
      }
    },
    "The changes have not been saved and will be lost." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Änderungen wurden nicht gespeichert und gehen verloren."
          }
        }
      }
    },
    "The file association could not be changed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
