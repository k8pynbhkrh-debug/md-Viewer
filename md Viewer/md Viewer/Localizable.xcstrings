{
  "sourceLanguage" : "en",
  "strings" : {
    "Alternatively, in the Finder: select a .md file, open Get Info (⌘I), choose md Viewer under Open with, and click Change All." : {
      "comment" : "Fallback hint shown when setting md Viewer as the default .md app fails (Mac).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternativ im Finder: eine .md-Datei auswählen, „Informationen“ (⌘I) öffnen, unter „Öffnen mit“ md Viewer wählen und „Alle ändern …“."
          }
        }
      }
    },
    "Blank Document" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leeres Dokument"
