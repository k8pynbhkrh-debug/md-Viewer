      }
    },
    "The file association was not applied." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zuordnung wurde nicht übernommen."
          }
        }
      }
    },
    "The file could not be read as text. Only UTF-8 encoded files are supported." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei konnte nicht als Text gelesen werden. Nur UTF-8-kodierte Dateien werden unterstützt."
          }
        }
      }
    },
    "The file could not be read." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei konnte nicht gelesen werden."
          }
        }
      }
    },
    "The file could not be saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei konnte nicht gespeichert werden."
          }
        }
      }
    },
    "The file is empty." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei ist leer."
          }
        }
      }
    },
    "The file is too large (%@). The maximum supported size is 5 MB." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
